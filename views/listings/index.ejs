<% layout('layouts/boilerplate') %> 
<!-- <h3>All Listings</h3> -->
<style>
    
</style>

<div class="filter-container">

    <button class="scroll-btn left">
        <i class="fa-solid fa-chevron-left"></i>
    </button>

   <div id="filters">

<div class="filter <%= !category ? 'active' : '' %>" data-category="">
    <i class="fa-solid fa-border-all"></i>
    <p>All</p>
</div>

<div class="filter <%= category === 'Trending' ? 'active' : '' %>" data-category="Trending">
    <i class="fa-solid fa-fire"></i>
    <p>Trending</p>
</div>

<div class="filter <%= category === 'Rooms' ? 'active' : '' %>" data-category="Rooms">
    <i class="fa-solid fa-bed"></i>
    <p>Rooms</p>
</div>

<div class="filter <%= category === 'Cities' ? 'active' : '' %>" data-category="Cities">
    <i class="fa-solid fa-mountain-city"></i>
    <p>Cities</p>
</div>

<div class="filter <%= category === 'Beach' ? 'active' : '' %>" data-category="Beach">
    <i class="fa-solid fa-umbrella-beach"></i>
    <p>Beach</p>
</div>

<div class="filter <%= category === 'Mountains' ? 'active' : '' %>" data-category="Mountains">
    <i class="fa-solid fa-mountain"></i>
    <p>Mountains</p>
</div>

<div class="filter <%= category === 'Pools' ? 'active' : '' %>" data-category="Pools">
    <i class="fa-solid fa-person-swimming"></i>
    <p>Pools</p>
</div>

<div class="filter <%= category === 'Cabins' ? 'active' : '' %>" data-category="Cabins">
    <i class="fa-solid fa-house"></i>
    <p>Cabins</p>
</div>

<div class="filter <%= category === 'Luxury' ? 'active' : '' %>" data-category="Luxury">
    <i class="fa-solid fa-gem"></i>
    <p>Luxury</p>
</div>

<div class="filter <%= category === 'Camping' ? 'active' : '' %>" data-category="Camping">
    <i class="fa-solid fa-campground"></i>
    <p>Camping</p>
</div>

<div class="filter <%= category === 'Lakefront' ? 'active' : '' %>" data-category="Lakefront">
    <i class="fa-solid fa-water"></i>
    <p>Lakefront</p>
</div>

<div class="filter <%= category === 'Historic' ? 'active' : '' %>" data-category="Historic">
    <i class="fa-solid fa-building-columns"></i>
    <p>Historic</p>
</div>

</div>

    <div class="tax-toggle">
        <div class="form-check form-switch">
            <input
                class="form-check-input"
                type="checkbox"
                id="taxSwitch">

            <label
                class="form-check-label"
                for="taxSwitch">
                Display total after tax
            </label>
        </div>
    </div>

    <button class="scroll-btn right">
        <i class="fa-solid fa-chevron-right"></i>
    </button>

</div>


<% if(allListings.length===0){ %>

<div class="alert alert-warning text-center my-4">

<h5>No listings found.</h5>

<p>Try searching with another destination.</p>

</div>

<% } %>

<div class="row">
<% for(let listing of allListings){ %>

<div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mb-4">

<a href="/listings/<%= listing._id %>" class="listing-link">

<div class="listing-card">

<% if(currUser){ %>

<form
action="/wishlist/<%= listing._id %>"
method="POST"
class="wishlist-form">

<button
type="submit"
class="wishlist-btn">

<i class="fa-<%= wishlist.includes(listing._id.toString()) ? 'solid' : 'regular' %> fa-heart"></i>

</button>

</form>

<% } %>
<div class="rating-badge">
    <i class="fa-solid fa-star"></i>

    <% if(listing.reviewCount > 0){ %>
        <%= listing.avgRating %>
    <% } else { %>
        New
    <% } %>
</div>

<img
src="<%= listing.image.url %>"
class="card-img-top"
alt="<%= listing.title %>">

<div class="card-body">

<h5 class="listing-title">
<%= listing.title %>
</h5>

<div class="listing-location">
<i class="fa-solid fa-location-dot"></i>
<%= listing.location %>, <%= listing.country %>
</div>


<div class="price-row">

<div>

<span
class="listing-price price"
data-price="<%= listing.price %>">

₹ <%= listing.price.toLocaleString("en-IN") %>

</span>

<span class="night">
/ night
</span>

</div>

<div>

<span class="text-muted-custom">

Guest Favourite

</span>

</div>

</div>

</div>

</div>

</a>

</div>

<% } %>



</div>


<script>

const taxSwitch = document.getElementById("taxSwitch");

if(taxSwitch){

    taxSwitch.addEventListener("change",()=>{

        document.querySelectorAll(".price").forEach(price=>{

            const original = Number(price.dataset.price);

            const value = taxSwitch.checked
                ? Math.round(original*1.18)
                : original;

            price.innerHTML = "₹ " + value.toLocaleString("en-IN");

        });

    });

}

</script>

<script>
document.querySelectorAll(".filter").forEach(filter => {

    filter.addEventListener("click", function () {

        const category = this.dataset.category;

        if (category === "") {
            window.location.href = "/listings";
        } else {
            window.location.href = `/listings?category=${category}`;
        }

    });

});
</script>

<script>

document.querySelectorAll(".wishlist-btn").forEach(btn=>{

btn.addEventListener("click",function(e){

e.preventDefault();

const icon=this.querySelector("i");

icon.classList.toggle("fa-regular");

icon.classList.toggle("fa-solid");

icon.style.color="#ff385c";

});

});

</script>
<script>

const filters = document.getElementById("filters");

const leftButton = document.querySelector(".scroll-btn.left");
const rightButton = document.querySelector(".scroll-btn.right");

if (filters && leftButton && rightButton) {

    rightButton.addEventListener("click", function () {

        filters.scrollBy({
            left: 250,
            behavior: "smooth"
        });

    });

    leftButton.addEventListener("click", function () {

        filters.scrollBy({
            left: -250,
            behavior: "smooth"
        });

    });

}

</script>