<% layout('layouts/boilerplate') %> 
<!-- <h3>All Listings</h3> -->
<style>
.ai-hub{position:relative;margin:35px auto 45px;padding:34px 38px 20px;border-radius:32px;overflow:hidden;background:linear-gradient(135deg,#f4eaff 0%,#edf2ff 48%,#fff0f6 100%);box-shadow:0 18px 45px rgba(48,38,100,.10)}
.ai-hub:before{content:"";position:absolute;width:430px;height:430px;left:-180px;bottom:-250px;border-radius:50%;background:radial-gradient(circle,#ffcdbb 0%,transparent 68%);opacity:.75}
.ai-hub:after{content:"";position:absolute;width:450px;height:450px;right:-180px;top:-280px;border-radius:50%;background:radial-gradient(circle,#cbd7ff 0%,transparent 68%);opacity:.7}
.ai-sparkle{position:absolute;z-index:1;font-size:24px;opacity:.65}
.sparkle-one{left:5%;top:20%}.sparkle-two{left:35%;top:8%}.sparkle-three{right:4%;bottom:24%}
.ai-content{position:relative;z-index:2;display:grid;grid-template-columns:34% 66%;gap:28px;align-items:stretch}
.ai-intro{position:relative;display:flex;flex-direction:column;justify-content:center;padding:28px 20px 28px 12px;min-height:360px}
.ai-badge{display:inline-flex;align-items:center;width:max-content;padding:8px 15px;border-radius:30px;background:rgba(255,255,255,.85);color:#6941e8;font-weight:700;font-size:14px;box-shadow:0 5px 15px rgba(80,50,150,.07)}
.ai-intro h2{font-size:46px;line-height:1.05;font-weight:850;letter-spacing:-2px;color:#18213d;margin:20px 0 12px}
.ai-intro h2 span{color:#6941e8}
.ai-tagline{font-size:19px;line-height:1.55;color:#515b75;max-width:430px;margin:0 0 25px}
.ai-actions{display:flex;gap:12px;flex-wrap:wrap}
.ai-primary,.ai-secondary{display:inline-flex;align-items:center;padding:13px 20px;border-radius:13px;text-decoration:none;font-weight:700;transition:.25s}
.ai-primary{background:#38227d;color:#fff;box-shadow:0 8px 18px rgba(56,34,125,.2)}
.ai-primary:hover{background:#2b195f;color:#fff;transform:translateY(-3px)}
.ai-secondary{background:rgba(255,255,255,.85);border:1px solid #c9cde0;color:#202943}
.ai-secondary:hover{background:#fff;color:#202943;transform:translateY(-3px)}
.ai-travel-art{position:absolute;right:5px;bottom:8px;font-size:54px;opacity:.9;filter:drop-shadow(0 8px 8px rgba(0,0,0,.08))}
.ai-features{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.ai-feature-link{display:block;text-decoration:none;color:inherit}
.ai-feature{position:relative;min-height:170px;padding:23px 24px;border:1px solid rgba(255,255,255,.95);border-radius:23px;background:rgba(255,255,255,.76);backdrop-filter:blur(10px);box-shadow:0 9px 25px rgba(42,42,90,.07);overflow:hidden;transition:.28s}
.ai-feature:after{content:"";position:absolute;width:100px;height:100px;right:-35px;bottom:-45px;border-radius:50%;background:rgba(110,80,240,.08)}
.ai-feature-link:hover .ai-feature{transform:translateY(-6px);background:rgba(255,255,255,.95);box-shadow:0 17px 32px rgba(42,42,90,.13)}
.ai-icon-box{width:54px;height:54px;display:flex;align-items:center;justify-content:center;border-radius:16px;font-size:29px;background:#f1eaff;margin-bottom:15px}
.ai-feature:nth-child(2) .ai-icon-box{background:#fff0d9}
.ai-feature:nth-child(3) .ai-icon-box{background:#e6f8ee}
.ai-feature:nth-child(4) .ai-icon-box{background:#e5f0ff}
.ai-feature h4{font-size:21px;line-height:1.2;font-weight:750;color:#19223e;margin:0 0 8px}
.ai-feature p{font-size:15px;line-height:1.45;color:#626b82;margin:0;max-width:300px}
.ai-explore{display:inline-block;margin-top:13px;color:#6540e8;font-weight:750;font-size:14px}
.ai-bottom{position:relative;z-index:3;margin-top:22px;padding:6px;background:rgba(255,255,255,.88);border:1px solid rgba(255,255,255,.95);border-radius:21px;display:grid;grid-template-columns:repeat(4,1fr);box-shadow:0 8px 24px rgba(40,40,80,.06)}
.ai-mini{display:flex;align-items:center;gap:13px;padding:18px 22px;color:inherit;text-decoration:none;border-right:1px solid #ddd;transition:.25s}
.ai-mini:last-child{border-right:0}
.ai-mini:hover{background:#fff;border-radius:15px;transform:translateY(-2px)}
.ai-mini:hover strong{color:#6540e8}
.ai-mini-icon{width:42px;height:42px;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:13px;background:#f1eaff;font-size:22px}
.ai-mini strong{display:block;font-size:16px;color:#1b2440;margin-bottom:3px}
.ai-mini span{display:block;font-size:13px;color:#70788d;line-height:1.35}
.ai-section-label{display:flex;align-items:center;justify-content:space-between;margin:0 4px 18px}
.ai-section-label h3{font-size:25px;font-weight:800;margin:0;color:#1b2440}
.ai-section-label span{font-size:14px;color:#6540e8;font-weight:700}
@media(max-width:992px){.ai-content{grid-template-columns:1fr}.ai-intro{text-align:center;align-items:center}.ai-travel-art{display:none}.ai-bottom{grid-template-columns:1fr 1fr}.ai-mini:nth-child(2){border-right:0}.ai-intro h2{font-size:40px}}
@media(max-width:650px){.ai-hub{padding:24px 18px 18px}.ai-features{grid-template-columns:1fr}.ai-bottom{grid-template-columns:1fr}.ai-mini{border-right:0;border-bottom:1px solid #ddd}.ai-mini:last-child{border-bottom:0}.ai-intro h2{font-size:36px}}

/* ================================
   STAYNEST HERO
================================ */

.stn-hero {
    position: relative;
    min-height: 430px;
    margin: 25px auto 35px;
    width: calc(100% - 40px);
    max-width: 1500px;
    border-radius: 28px;
    overflow: hidden;

    background-image: url("https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1800&q=85");
    background-size: cover;
    background-position: center;
}

.stn-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        90deg,
        rgba(0,0,0,.65) 0%,
        rgba(0,0,0,.35) 45%,
        rgba(0,0,0,.15) 100%
    );
}

.stn-hero-content {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 75px 45px 50px;
    color: white;
}

.stn-hero-badge {
    display: inline-flex;
    padding: 9px 16px;
    border-radius: 999px;
    background: rgba(255,255,255,.18);
    backdrop-filter: blur(10px);
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 18px;
}

.stn-hero h1 {
    margin: 0;
    font-size: clamp(42px, 5vw, 68px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -2px;
}

.stn-hero p {
    margin: 18px 0 35px;
    font-size: 20px;
    color: rgba(255,255,255,.9);
}

.stn-hero-search {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 8px;
    background: white;
    border-radius: 18px;
    box-shadow: 0 15px 40px rgba(0,0,0,.22);
}

.stn-hero-search .stn-search-field {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    padding: 12px 16px;
}

.stn-hero-search .stn-search-field > i {
    color: #ff5a5f;
    font-size: 19px;
}

.stn-hero-search .stn-search-field label {
    display: block;
    margin-bottom: 4px;
    font-size: 12px;
    font-weight: 700;
    color: #222;
}

.stn-hero-search .stn-search-field input {
    width: 100%;
    border: none;
    outline: none;
    font-size: 14px;
    color: #555;
    background: transparent;
}

.stn-hero-search .stn-search-divider {
    width: 1px;
    height: 40px;
    background: #e5e5e5;
}

.stn-hero-search .stn-search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    min-width: 125px;
    height: 55px;

    border: none;
    border-radius: 14px;

    background: #ff5a5f;
    color: white;

    font-size: 15px;
    font-weight: 700;

    cursor: pointer;
    transition: .25s;
}

.stn-hero-search .stn-search-btn:hover {
    background: #e94b50;
    transform: translateY(-2px);
}

@media(max-width: 1000px) {

    .stn-hero-search {
        flex-wrap: wrap;
    }

    .stn-hero-search .stn-search-field {
        min-width: 45%;
    }

    .stn-hero-search .stn-search-divider {
        display: none;
    }

    .stn-hero-search .stn-search-btn {
        width: 100%;
    }
}

@media(max-width: 600px) {

    .stn-hero {
        width: calc(100% - 20px);
        min-height: 550px;
        border-radius: 20px;
    }

    .stn-hero-content {
        padding: 50px 22px 30px;
    }

    .stn-hero h1 {
        font-size: 42px;
    }

    .stn-hero p {
        font-size: 17px;
    }

    .stn-hero-search {
        flex-direction: column;
    }

    .stn-hero-search .stn-search-field {
        width: 100%;
        min-width: 100%;
    }

    .stn-hero-search .stn-search-btn {
        width: 100%;
    }
}
/* ================================
   STAYNEST CATEGORY BAR
================================ */

.stn-category-wrapper {
    position: relative;

    display: flex;
    align-items: center;

    max-width: 1500px;
    margin: 0 auto 35px;
    padding: 0 55px;

    background: #fff;
}

.stn-categories {
    display: flex;
    align-items: flex-start;
    gap: 34px;

    width: 100%;

    overflow-x: auto;
    scroll-behavior: smooth;

    scrollbar-width: none;
}

.stn-categories::-webkit-scrollbar {
    display: none;
}

.stn-categories .filter {
    position: relative;

    flex: 0 0 auto;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    min-width: 65px;
    padding: 8px 4px 12px;

    color: #6b7280;

    cursor: pointer;

    transition: all .25s ease;
}

.stn-categories .filter i {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 48px;
    height: 48px;

    margin-bottom: 7px;

    border-radius: 50%;

    background: #f5f5f7;

    font-size: 20px;

    transition: all .25s ease;
}

.stn-categories .filter p {
    margin: 0;

    font-size: 13px;
    font-weight: 600;

    white-space: nowrap;
}

.stn-categories .filter:hover {
    color: #ff5a5f;
}

.stn-categories .filter:hover i {
    transform: translateY(-3px);
    background: #fff0f1;
    color: #ff5a5f;
}

.stn-categories .filter.active {
    color: #ff5a5f;
}

.stn-categories .filter.active i {
    background: #ff5a5f;
    color: white;

    box-shadow:
        0 7px 18px rgba(255, 90, 95, .25);
}

.stn-categories .filter.active::after {
    content: "";

    position: absolute;

    bottom: 0;
    left: 50%;

    width: 45px;
    height: 3px;

    border-radius: 5px;

    background: #ff5a5f;

    transform: translateX(-50%);
}


/* CATEGORY ARROWS */

.stn-category-arrow {
    position: absolute;
    z-index: 5;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 42px;
    height: 42px;

    border: 1px solid #e5e7eb;
    border-radius: 50%;

    background: white;

    color: #444;

    cursor: pointer;

    box-shadow: 0 5px 15px rgba(0,0,0,.08);

    transition: all .2s ease;
}

.stn-category-arrow:hover {
    transform: scale(1.05);
    box-shadow: 0 7px 18px rgba(0,0,0,.13);
}

.stn-category-left {
    left: 8px;
}

.stn-category-right {
    right: 8px;
}


/* DESKTOP */

@media (min-width: 1200px) {

    .stn-categories {
        justify-content: space-between;
    }

}


/* TABLET */

@media (max-width: 900px) {

    .stn-category-wrapper {
        padding: 0 45px;
    }

    .stn-categories {
        gap: 25px;
    }

}


/* MOBILE */

@media (max-width: 600px) {

    .stn-category-wrapper {
        padding: 0 40px;
        margin-bottom: 25px;
    }

    .stn-categories {
        gap: 20px;
    }

    .stn-categories .filter i {
        width: 43px;
        height: 43px;
        font-size: 18px;
    }

    .stn-categories .filter p {
        font-size: 12px;
    }

    .stn-category-arrow {
        width: 36px;
        height: 36px;
    }

}
/* ================================
   EXPLORE DESTINATIONS
================================ */

.stn-destinations {
    max-width: 1500px;
    margin: 55px auto 65px;
    padding: 0 20px;
}

.stn-section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
}

.stn-eyebrow {
    display: block;
    margin-bottom: 7px;

    color: #ff5a5f;

    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.stn-section-heading h2 {
    margin: 0;

    color: #18213d;

    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.8px;
}

.stn-section-heading p {
    margin: 7px 0 0;

    color: #6b7280;
    font-size: 15px;
}

.stn-view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    color: #ff5a5f;
    text-decoration: none;

    font-size: 14px;
    font-weight: 700;

    white-space: nowrap;

    transition: .2s;
}

.stn-view-all:hover {
    color: #e5484d;
    gap: 12px;
}


/* DESTINATION GRID */

.stn-destination-grid {
    display: grid;

    grid-template-columns: 1.35fr 1fr 1fr;
    grid-template-rows: 230px 230px;

    gap: 16px;
}

.stn-destination-card {
    position: relative;

    display: block;

    overflow: hidden;

    border-radius: 22px;

    text-decoration: none;

    background: #eee;
}

.stn-destination-large {
    grid-row: span 2;
}

.stn-destination-card img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform .55s ease;
}

.stn-destination-card:hover img {
    transform: scale(1.07);
}

.stn-destination-overlay {
    position: absolute;
    inset: 0;

    background: linear-gradient(
        to top,
        rgba(0,0,0,.65),
        rgba(0,0,0,.05) 65%
    );
}

.stn-destination-info {
    position: absolute;

    left: 22px;
    bottom: 20px;

    color: white;
}

.stn-destination-info h3 {
    margin: 0 0 4px;

    font-size: 24px;
    font-weight: 800;
}

.stn-destination-info span {
    font-size: 13px;

    color: rgba(255,255,255,.9);
}


/* RESPONSIVE */

@media (max-width: 900px) {

    .stn-destination-grid {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 230px 200px 200px;
    }

    .stn-destination-large {
        grid-column: span 2;
        grid-row: auto;
    }

}

@media (max-width: 600px) {

    .stn-destinations {
        margin: 40px auto 45px;
        padding: 0 14px;
    }

    .stn-section-heading {
        align-items: flex-start;
    }

    .stn-section-heading h2 {
        font-size: 25px;
    }

    .stn-section-heading p {
        font-size: 14px;
    }

    .stn-destination-grid {
        display: flex;
        flex-direction: column;
    }

    .stn-destination-card,
    .stn-destination-large {
        height: 210px;
    }

    .stn-destination-info h3 {
        font-size: 22px;
    }
}
/* ================================
   FEATURED STAYS
================================ */

.stn-featured-heading {
    max-width: 1500px;
    margin: 65px auto 25px;
    padding: 0 20px;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
}

.stn-featured-heading h2 {
    margin: 0;

    color: #18213d;

    font-size: 30px;
    font-weight: 800;
    letter-spacing: -.8px;
}

.stn-featured-heading p {
    margin: 7px 0 0;

    color: #6b7280;
    font-size: 15px;
}


/* Make listing cards feel premium */

.listing-link {
    display: block;
    text-decoration: none;
    color: inherit;
}

.listing-card {
    position: relative;

    overflow: hidden;

    border-radius: 18px;

    background: #fff;

    transition:
        transform .3s ease,
        box-shadow .3s ease;
}

.listing-card:hover {
    transform: translateY(-6px);

    box-shadow:
        0 18px 40px rgba(0,0,0,.12);
}

.listing-card .card-img-top {
    height: 245px;

    object-fit: cover;

    transition: transform .45s ease;
}

.listing-card:hover .card-img-top {
    transform: scale(1.04);
}

.listing-card .card-body {
    padding: 15px 4px 10px;
}

.listing-title {
    margin-bottom: 6px;

    color: #18213d;

    font-size: 16px;
    font-weight: 700;
}

.listing-location {
    color: #737986;

    font-size: 13px;
}

.price-row {
    margin-top: 10px;
}

.listing-price {
    color: #18213d;
    font-weight: 800;
}

.night {
    color: #737986;
    font-size: 13px;
}

.text-muted-custom {
    color: #777;
    font-size: 12px;
}


/* RESPONSIVE */

@media(max-width:600px) {

    .stn-featured-heading {
        margin-top: 45px;
        padding: 0 14px;
    }

    .stn-featured-heading h2 {
        font-size: 25px;
    }

    .stn-featured-heading p {
        font-size: 13px;
    }

    .stn-featured-heading .stn-view-all {
        font-size: 13px;
    }

    .listing-card .card-img-top {
        height: 210px;
    }

}
/* ================================
   FEATURED STAYS CAROUSEL
================================ */

.stn-featured-wrapper {
    position: relative;

    max-width: 1500px;

    margin: 0 auto 65px;
    padding: 0 55px;
}

.stn-featured-slider {
    display: flex;

    gap: 22px;

    overflow-x: auto;

    scroll-behavior: smooth;

    scrollbar-width: none;

    padding: 8px 4px 20px;
}

.stn-featured-slider::-webkit-scrollbar {
    display: none;
}

.stn-featured-item {
    flex: 0 0 calc(25% - 17px);

    min-width: 260px;
}


/* ARROWS */

.stn-featured-arrow {
    position: absolute;
    z-index: 10;

    top: 42%;

    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid #e5e7eb;
    border-radius: 50%;

    background: white;

    color: #333;

    cursor: pointer;

    box-shadow: 0 6px 18px rgba(0,0,0,.12);

    transition: all .2s ease;
}

.stn-featured-arrow:hover {
    transform: scale(1.08);

    box-shadow:
        0 9px 25px rgba(0,0,0,.16);
}

.stn-featured-left {
    left: 5px;
}

.stn-featured-right {
    right: 5px;
}


/* RESPONSIVE */

@media(max-width:1100px) {

    .stn-featured-item {
        flex: 0 0 calc(33.333% - 15px);
    }

}

@media(max-width:800px) {

    .stn-featured-wrapper {
        padding: 0 45px;
    }

    .stn-featured-item {
        flex: 0 0 calc(50% - 11px);
    }

}

@media(max-width:550px) {

    .stn-featured-wrapper {
        padding: 0 35px;
    }

    .stn-featured-slider {
        gap: 15px;
    }

    .stn-featured-item {
        flex: 0 0 82%;
    }

    .stn-featured-arrow {
        width: 38px;
        height: 38px;
    }

}
/* ================================
   STAYNEST AI
================================ */

.stn-ai-section {
    position: relative;
    max-width: 1500px;
    margin: 65px auto;
    padding: 38px;
    border-radius: 30px;
    overflow: hidden;

    background: linear-gradient(
        135deg,
        #f5efff 0%,
        #edf3ff 50%,
        #fff1f6 100%
    );

    box-shadow: 0 18px 45px rgba(48,38,100,.09);
}

.stn-ai-section::before {
    content: "";
    position: absolute;

    width: 400px;
    height: 400px;

    left: -180px;
    bottom: -240px;

    border-radius: 50%;

    background: radial-gradient(
        circle,
        #ffcdbb,
        transparent 70%
    );

    opacity: .6;
}

.stn-ai-section::after {
    content: "";
    position: absolute;

    width: 420px;
    height: 420px;

    right: -180px;
    top: -260px;

    border-radius: 50%;

    background: radial-gradient(
        circle,
        #cbd7ff,
        transparent 70%
    );

    opacity: .6;
}

.stn-ai-header {
    position: relative;
    z-index: 2;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;
    margin-bottom: 28px;
}

.stn-ai-badge {
    display: inline-flex;

    padding: 7px 14px;

    border-radius: 999px;

    background: rgba(255,255,255,.8);

    color: #6941e8;

    font-size: 13px;
    font-weight: 800;
}

.stn-ai-header h2 {
    margin: 12px 0 7px;

    color: #18213d;

    font-size: 32px;
    font-weight: 800;

    letter-spacing: -.8px;
}

.stn-ai-header h2 span {
    color: #6941e8;
}

.stn-ai-header p {
    margin: 0;

    color: #626b82;
    font-size: 15px;
}

