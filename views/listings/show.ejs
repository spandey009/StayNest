<% layout('layouts/boilerplate') %>

<script>
const coordinates=<%- JSON.stringify(listing.geometry.coordinates) %>;
const title="<%= listing.title %>";
const listinglocation="<%= listing.location %>";
const country="<%= listing.country %>";
</script>

<div class="container listing-container">

<!-- ================= HEADER ================= -->

<div class="listing-header">

<h1 class="listing-page-title">
<%= listing.title %>
</h1>

<div class="listing-meta">

<span>
<i class="fa-solid fa-star"></i>

<% if(listing.reviewCount>0){ %>
<%= listing.avgRating %>
<% } else { %>
New
<% } %>

</span>

<span>•</span>

<span>Guest Favourite</span>

<span>•</span>

<span>
<i class="fa-solid fa-location-dot"></i>
<%= listing.location %>,
<%= listing.country %>
</span>

</div>

</div>

<!-- ================= GALLERY ================= -->

<div class="gallery">

<div class="gallery-main">

<img
src="<%= listing.image.url %>"
alt="<%= listing.title %>">

<button class="view-photo-btn">
<i class="fa-solid fa-camera"></i>
View all photos
</button>

</div>

<div class="gallery-side">

<img
src="<%= listing.image.url %>"
alt="Listing">

<img
src="<%= listing.image.url %>"
alt="Listing">

<img
src="<%= listing.image.url %>"
alt="Listing">

<div class="gallery-last">

<img
src="<%= listing.image.url %>"
alt="Listing">

<div class="gallery-overlay">

<i class="fa-solid fa-images"></i>

<span>+12 Photos</span>

</div>

</div>

</div>

<% if(currUser){ %>

<form
action="/wishlist/<%= listing._id %>"
method="POST"
class="wishlist-form">

<button
type="submit"
class="wishlist-btn">

<i class="fa-<%= wishlist && wishlist.includes(listing._id.toString()) ? 'solid' : 'regular' %> fa-heart"></i>

</button>

</form>

<% } %>

</div>

<!-- ================= MAIN LAYOUT ================= -->

<div class="listing-layout">

<!-- LEFT COLUMN -->

<div class="listing-left">
    <!-- HOST -->

<div class="info-card">

<div class="host-info">

<img
src="<%= listing.owner.profileImage.url %>"
alt="Host"
class="rounded-circle border"
width="70"
height="70"
style="object-fit:cover;">

<div>

<h3>Hosted by <%= listing.owner.username %></h3>

<p class="mb-1">
Superhost • 2 Guests • 1 Bedroom • 1 Bath
</p>

<% if(currUser){ %>

<a
href="/users/<%= listing.owner._id %>"
class="text-primary text-decoration-none">
View Host Profile →
</a>

<% } else { %>

<small class="text-muted">
Login to view host profile
</small>

<% } %>

</div>

</div>

</div>

<!-- ABOUT -->

<div class="info-card">

<h3>
<i class="fa-solid fa-house"></i>
About this stay
</h3>

<p><%= listing.description %></p>

</div>

<!-- AMENITIES -->

<div class="info-card">

<h3>
<i class="fa-solid fa-star"></i>
What this place offers
</h3>

<div class="amenities-grid">

<div class="amenity">
<i class="fa-solid fa-wifi"></i>
<span>Free WiFi</span>
</div>

<div class="amenity">
<i class="fa-solid fa-square-parking"></i>
<span>Free Parking</span>
</div>

<div class="amenity">
<i class="fa-solid fa-snowflake"></i>
<span>Air Conditioning</span>
</div>

<div class="amenity">
<i class="fa-solid fa-tv"></i>
<span>Smart TV</span>
</div>

<div class="amenity">
<i class="fa-solid fa-kitchen-set"></i>
<span>Kitchen</span>
</div>

<div class="amenity">
<i class="fa-solid fa-shower"></i>
<span>Hot Shower</span>
</div>

<div class="amenity">
<i class="fa-solid fa-bed"></i>
<span>Comfort Bed</span>
</div>

<div class="amenity">
<i class="fa-solid fa-paw"></i>
<span>Pet Friendly</span>
</div>

</div>

</div>

</div>

<!-- RIGHT COLUMN -->

<div class="listing-right">

<div class="booking-card">
    <h2>₹ <%= listing.price.toLocaleString("en-IN") %><small>/ night</small></h2>

<p class="booking-rating">
<i class="fa-solid fa-star"></i>
<% if(listing.reviewCount>0){ %>
<%= listing.avgRating %> · <%= listing.reviewCount %> Reviews
<% } else { %>
New
<% } %>
</p>

<% if(!currUser){ %>

<div class="owner-booking-warning">
<i class="fa-solid fa-user-lock"></i>
<h5>Login Required</h5>
<p>Please login to reserve this stay.</p>
<a href="/login" class="host-btn mt-3 d-inline-block">Login</a>
</div>

<% } else if(listing.owner._id.equals(currUser._id)){ %>

<div class="owner-booking-warning">
<i class="fa-solid fa-circle-info"></i>
<h5>Your Listing</h5>
<p>You cannot book your own property.</p>
</div>

<% } else { %>

<form
    action="/bookings/<%= listing._id %>"
    method="POST"
    id="bookingForm"
    class="booking-form"
    data-listing-id="<%= listing._id %>">

<div class="booking-box">

<div class="booking-row">

<div class="booking-field">
<label>CHECK-IN</label>
<input type="date" id="checkIn" name="checkIn" required>
</div>

<div class="booking-field">
<label>CHECK-OUT</label>
<input type="date" id="checkOut" name="checkOut" required>
</div>

</div>

<div class="booking-guests booking-field">

<label>Guests</label>

<select name="guests" id="guests">

<% for(let i=1;i<=10;i++){ %>

<option value="<%= i %>">
<%= i %> Guest<%= i>1?"s":"" %>
</option>

<% } %>

</select>

</div>

</div>

<div class="price-details">

<div class="price-item">
<span>₹<%= listing.price.toLocaleString("en-IN") %> × <span id="nights">0</span> nights</span>
<span id="subtotal">₹0</span>
</div>

<div class="price-item">
<span>Cleaning Fee</span>
<span>₹200</span>
</div>

<div class="price-item">
<span>Service Fee</span>
<span>₹300</span>
</div>

<div class="price-item total">
<span>Total</span>
<span id="totalPrice">₹0</span>
</div>

</div>

<input type="hidden" name="nights" id="hiddenNights">
<input type="hidden" name="totalPrice" id="hiddenTotal">

<button type="submit" class="reserve-btn">
Reserve
</button>

</form>

<% } %>

<hr>

<p class="location-text">
<i class="fa-solid fa-location-dot"></i>
<%= listing.location %>, <%= listing.country %>
</p>

<div class="listing-category">
<i class="fa-solid fa-tags"></i>
<span><%= listing.category %></span>
</div>

<% if(currUser && listing.owner?._id.equals(currUser._id)){ %>

<div class="owner-actions mt-4">

<a href="/listings/<%= listing._id %>/edit" class="btn btn-dark w-100 mb-2">
Edit Listing
</a>

<a href="/listings/<%= listing._id %>/calendar" class="btn btn-primary w-100 mb-2">
<i class="fa-solid fa-calendar-days"></i>
Manage Availability
</a>

<form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
<button class="btn btn-danger w-100">
Delete Listing
</button>
</form>

</div>

<% } %>

</div>

</div>

</div>

<!-- REVIEW + MAP -->

<div class="bottom-layout">

<div class="review-column">
    <% if(currUser){ %>

<div class="review-form">

<h3>
<i class="fa-solid fa-star-half-stroke"></i>
Leave a Review
</h3>

<form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>

<fieldset class="starability-heart mb-4">

<input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating">

<input type="radio" id="second-rate1" name="review[rating]" value="1">
<label for="second-rate1">1 star</label>

<input type="radio" id="second-rate2" name="review[rating]" value="2">
<label for="second-rate2">2 stars</label>

<input type="radio" id="second-rate3" name="review[rating]" value="3">
<label for="second-rate3">3 stars</label>

<input type="radio" id="second-rate4" name="review[rating]" value="4">
<label for="second-rate4">4 stars</label>

<input type="radio" id="second-rate5" name="review[rating]" value="5">
<label for="second-rate5">5 stars</label>

</fieldset>

<div class="mb-4">

<label class="form-label">Your Experience</label>

<textarea
class="form-control"
name="review[comment]"
rows="5"
placeholder="Tell future guests about your stay..."
required></textarea>

<div class="invalid-feedback">
Please write a review.
</div>

</div>

<button class="btn review-btn">
<i class="fa-solid fa-paper-plane"></i>
Submit Review
</button>

</form>

</div>

<% } else { %>

<div class="review-form">

<h3>
<i class="fa-solid fa-star-half-stroke"></i>
Leave a Review
</h3>

<p class="text-muted">
Please <a href="/login">login</a> to leave a review.
</p>

</div>

<% } %>

</div>

<div class="map-column">

<h2 class="section-title">
<i class="fa-solid fa-location-dot"></i>
Where you'll be
</h2>

<div class="map-card">
<div id="map"></div>
</div>

</div>

</div>

<!-- GUEST REVIEWS -->

<% if(listing.reviews.length>0){ %>

<h2 class="section-title mt-5">
<i class="fa-solid fa-comments"></i>
Guest Reviews
<span class="review-count">(<%= listing.reviews.length %>)</span>
</h2>

<div class="review-grid">

<% for(let review of listing.reviews){ %>

<div class="review-card">

<div class="review-header">

<div class="review-user">

<div class="review-avatar">
<i class="fa-solid fa-user"></i>
</div>

<div>

<h5><%= review.author?.username || "Anonymous" %></h5>

<p class="review-date">
Guest Review
</p>

</div>

</div>

<div class="review-stars">

<div class="starability-result" data-rating="<%= review.rating %>">
Rated:
<%= review.rating %>
</div>

</div>

</div>

<p class="review-comment">
<%= review.comment %>
</p>

<% if(currUser && review.author && review.author._id.equals(currUser._id)){ %>

<form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" class="review-delete">

<button class="btn btn-outline-danger btn-sm">
<i class="fa-solid fa-trash"></i>
Delete Review
</button>

</form>

<% } %>

</div>

<% } %>

</div>

<% } %>
</div>

</div>

<script>

const wishlist=document.querySelector(".wishlist-btn");

if(wishlist){

wishlist.addEventListener("click",()=>{

const icon=wishlist.querySelector("i");

icon.classList.toggle("fa-regular");
icon.classList.toggle("fa-solid");

wishlist.classList.toggle("active");

});

}

</script>

<script>

const price=<%= listing.price %>;

const cleaningFee=200;
const serviceFee=300;

const checkIn=document.getElementById("checkIn");
const checkOut=document.getElementById("checkOut");

if(checkIn && checkOut){

const nightsText=document.getElementById("nights");
const subtotal=document.getElementById("subtotal");
const totalPrice=document.getElementById("totalPrice");

const hiddenNights=document.getElementById("hiddenNights");
const hiddenTotal=document.getElementById("hiddenTotal");

const today=new Date().toISOString().split("T")[0];

checkIn.min=today;
checkOut.min=today;

subtotal.innerText="₹0";
totalPrice.innerText="₹0";

function calculatePrice(){

if(!checkIn.value || !checkOut.value){

nightsText.innerText=0;
subtotal.innerText="₹0";
totalPrice.innerText="₹0";

hiddenNights.value=0;
hiddenTotal.value=0;

return;

}

const inDate=new Date(checkIn.value);
const outDate=new Date(checkOut.value);

const nights=Math.ceil((outDate-inDate)/(1000*60*60*24));

if(nights<=0){

alert("Check-out must be after Check-in.");

checkOut.value="";

nightsText.innerText=0;
subtotal.innerText="₹0";
totalPrice.innerText="₹0";

hiddenNights.value=0;
hiddenTotal.value=0;

return;

}

checkOut.min=checkIn.value;

const room=nights*price;
const total=room+cleaningFee+serviceFee;

nightsText.innerText=nights;
subtotal.innerText="₹"+room.toLocaleString("en-IN");
totalPrice.innerText="₹"+total.toLocaleString("en-IN");

hiddenNights.value=nights;
hiddenTotal.value=total;

}

checkIn.addEventListener("change",calculatePrice);
checkOut.addEventListener("change",calculatePrice);

}

</script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script src="/js/payment.js"></script>
<script src="/js/map.js"></script>