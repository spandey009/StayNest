<% layout("layouts/boilerplate") %>
<style>
.sn-policy-page{
    min-height:70vh;
    padding:55px 20px 70px;
    background:#f7f8fa;
}
.sn-policy-container{
    width:100%;
    max-width:900px;
    margin:0 auto;
}
.sn-policy-card{
    background:#fff;
    border:1px solid #eceef1;
    border-radius:26px;
    padding:45px;
    box-shadow:0 15px 45px rgba(0,0,0,.06);
}
.sn-policy-badge{
    display:inline-block;
    margin-bottom:10px;
    color:#ff5a5f;
    font-size:12px;
    font-weight:800;
    letter-spacing:1.6px;
}
.sn-policy-title{
    margin:0 0 8px;
    color:#18213d;
    font-size:42px;
    line-height:1.15;
    font-weight:800;
}
.sn-policy-date{
    margin:0 0 35px;
    color:#9297a0;
    font-size:14px;
}
.sn-policy-section{
    margin-bottom:28px;
}
.sn-policy-section:last-child{
    margin-bottom:0;
}
.sn-policy-section h2{
    margin:0 0 9px;
    color:#18213d;
    font-size:20px;
    font-weight:750;
}
.sn-policy-section p{
    margin:0;
    color:#596174;
    font-size:15px;
    line-height:1.75;
}
.sn-policy-section a{
    color:#ff5a5f;
    font-weight:650;
    text-decoration:none;
}
.sn-policy-section a:hover{
    text-decoration:underline;
}
@media(max-width:650px){
    .sn-policy-page{
        padding:35px 14px 50px;
    }
    .sn-policy-card{
        padding:28px 20px;
        border-radius:20px;
    }
    .sn-policy-title{
        font-size:32px;
    }
}
</style>
<div class="sn-policy-page">
    <div class="sn-policy-container">
        <div class="sn-policy-card">
            <span class="sn-policy-badge">STAYNEST</span>
            <h1 class="sn-policy-title">Privacy Policy</h1>
            <p class="sn-policy-date">Last updated: August 2026</p>
            <div class="sn-policy-section">
                <h2>1. Information We Collect</h2>
                <p>StayNest may collect information such as your username, email address, profile information, booking details, listing information and trip preferences when required to provide platform services.</p>
            </div>
            <div class="sn-policy-section">
                <h2>2. How We Use Information</h2>
                <p>Your information may be used to manage accounts, process bookings, provide personalized travel features, communicate important updates, provide customer support and improve StayNest.</p>
            </div>
            <div class="sn-policy-section">
                <h2>3. Account Information</h2>
                <p>You are responsible for keeping your account information accurate and maintaining the security of your login credentials.</p>
            </div>
            <div class="sn-policy-section">
                <h2>4. Payments</h2>
                <p>Payments are processed through the payment provider configured for StayNest. Payment information is handled according to the provider's security and privacy policies.</p>
            </div>
            <div class="sn-policy-section">
                <h2>5. AI Features</h2>
                <p>StayNest includes AI-powered features such as trip planning, recommendations and support. Information required to provide these features may be processed to generate relevant responses and recommendations.</p>
            </div>
            <div class="sn-policy-section">
                <h2>6. Data Security</h2>
                <p>StayNest uses reasonable technical and organizational measures to protect application and account information. However, no internet-based system can guarantee absolute security.</p>
            </div>
            <div class="sn-policy-section">
                <h2>7. Contact</h2>
                <p>If you have questions about privacy, visit our <a href="/contact">Contact Us</a> page or use <a href="/support">24×7 Support</a>.</p>
            </div>
        </div>
    </div>
</div>