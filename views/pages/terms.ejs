<% layout("layouts/boilerplate") %>
<style>
.sn-policy-page{
    min-height:70vh;
    padding:55px 20px 70px;
    background:#f7f8fa;
}
.sn-policy-container{
    width:100%;
    max-width:900px;
    margin:0 auto;
}
.sn-policy-card{
    background:#fff;
    border:1px solid #eceef1;
    border-radius:26px;
    padding:45px;
    box-shadow:0 15px 45px rgba(0,0,0,.06);
}
.sn-policy-badge{
    display:inline-block;
    margin-bottom:10px;
    color:#ff5a5f;
    font-size:12px;
    font-weight:800;
    letter-spacing:1.6px;
}
.sn-policy-title{
    margin:0 0 8px;
    color:#18213d;
    font-size:42px;
    line-height:1.15;
    font-weight:800;
}
.sn-policy-date{
    margin:0 0 35px;
    color:#9297a0;
    font-size:14px;
}
.sn-policy-section{
    margin-bottom:28px;
}
.sn-policy-section:last-child{
    margin-bottom:0;
}
.sn-policy-section h2{
    margin:0 0 9px;
    color:#18213d;
    font-size:20px;
    font-weight:750;
}
.sn-policy-section p{
    margin:0;
    color:#596174;
    font-size:15px;
    line-height:1.75;
}
.sn-policy-section a{
    color:#ff5a5f;
    font-weight:650;
    text-decoration:none;
}
.sn-policy-section a:hover{
    text-decoration:underline;
}
@media(max-width:650px){
    .sn-policy-page{
        padding:35px 14px 50px;
    }
    .sn-policy-card{
        padding:28px 20px;
        border-radius:20px;
    }
    .sn-policy-title{
        font-size:32px;
    }
}
</style>
<div class="sn-policy-page">
    <div class="sn-policy-container">
        <div class="sn-policy-card">
            <span class="sn-policy-badge">STAYNEST</span>
            <h1 class="sn-policy-title">Terms & Conditions</h1>
            <p class="sn-policy-date">Last updated: August 2026</p>
            <div class="sn-policy-section">
                <h2>1. Using StayNest</h2>
                <p>By using StayNest, you agree to use the platform responsibly and provide accurate information when creating an account, listing a property or making a booking.</p>
            </div>
            <div class="sn-policy-section">
                <h2>2. User Accounts</h2>
                <p>Users are responsible for maintaining the security of their account credentials and for activity performed through their account.</p>
            </div>
            <div class="sn-policy-section">
                <h2>3. Listings</h2>
                <p>Hosts are responsible for ensuring that property descriptions, prices, images, locations, availability and other listing information are accurate and up to date.</p>
            </div>
            <div class="sn-policy-section">
                <h2>4. Bookings & Payments</h2>
                <p>Bookings are subject to availability and successful payment confirmation where payment is required. Applicable cancellation and refund rules apply to individual bookings.</p>
            </div>
            <div class="sn-policy-section">
                <h2>5. Reviews</h2>
                <p>Reviews should be honest, relevant and respectful. StayNest may take action against content that violates platform rules.</p>
            </div>
            <div class="sn-policy-section">
                <h2>6. AI Features</h2>
                <p>AI-generated recommendations, trip plans and support responses are provided as assistance and may not always be completely accurate. Important travel, booking and payment information should be verified before making decisions.</p>
            </div>
            <div class="sn-policy-section">
                <h2>7. Support</h2>
                <p>StayNest provides AI-assisted support and may escalate conversations to human support when necessary.</p>
            </div>
            <div class="sn-policy-section">
                <h2>8. Contact</h2>
                <p>For questions regarding these terms, visit <a href="/contact">Contact Us</a> or use <a href="/support">24×7 Support</a>.</p>
            </div>
        </div>
    </div>
</div>