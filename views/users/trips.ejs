<% layout("layouts/boilerplate") %>

<h2 class="mb-4">
    <i class="fa-solid fa-suitcase"></i>
    My Trips
</h2>

<% if(bookings.length === 0){ %>

<div class="alert alert-info">
    You haven't booked any trips yet.
</div>

<% } %>

<div class="row">

<% bookings.forEach(booking => { %>

<div class="col-lg-4 col-md-6 mb-4">

<div class="card shadow-sm h-100 <%= booking.status === 'Cancelled' ? 'cancelled' : '' %>">

<img
src="<%= booking.listing.image.url %>"
class="card-img-top"
style="height:220px;object-fit:cover;">

<div class="card-body">

<h5>
<%= booking.listing.title %>
</h5>

<p>

<i class="fa-solid fa-location-dot"></i>

<%= booking.listing.location %>,
<%= booking.listing.country %>

</p>

<p>

📅

<%= booking.checkIn.toDateString() %>

<br>

<%= booking.checkOut.toDateString() %>

</p>

<p>

👤 <%= booking.guests %> Guest(s)

</p>

<p>

🌙 <%= booking.nights %> Night(s)

</p>

<h5>

₹ <%= booking.totalPrice.toLocaleString("en-IN") %>

</h5>

<% if(booking.status === "Confirmed"){ %>

<span class="badge bg-success">

    Confirmed

</span>

<form
    action="/bookings/<%= booking._id %>/cancel?_method=PUT"
    method="POST"
    class="mt-3">

    <button
        class="btn btn-outline-danger w-100">

        <i class="fa-solid fa-ban"></i>

        Cancel Booking

    </button>

</form>

<% } else { %>

<span class="badge bg-danger">

    Cancelled

</span>

<% } %>

</div>

</div>

</div>

<% }) %>

</div>