<% layout("layouts/boilerplate") %>

<div class="container mt-5">

    <!-- Profile Card -->

    <div class="card shadow-lg border-0 rounded-4 p-4 profile-card">

        <div class="row align-items-center">

            <div class="col-md-3 text-center">

                <img
                    src="<%= user.profileImage.url %>"
                    class="rounded-circle border"
                    width="180"
                    height="180"
                    style="object-fit: cover;"
                >

            </div>

            <div class="col-md-9">

                <h2 class="fw-bold">
                    <%= user.username %>
                </h2>

                <p class="text-muted mb-1">
                    <%= user.email %>
                </p>

                <p>
                    📍 <%= user.location || "Location not specified" %>
                </p>

                <p>
                    Member since
                    <%= user.joinedAt.toDateString() %>
                </p>

                <% if(currUser && currUser._id.equals(user._id)){ %>

                <div class="mt-3 d-flex gap-2 flex-wrap">

                    <a href="/users/<%= user._id %>/edit"
                       class="btn btn-dark">
                        <i class="fa-solid fa-user-pen"></i>
                        Edit Profile
                    </a>

                    <a href="/listings/new"
                       class="btn btn-success">
                        <i class="fa-solid fa-plus"></i>
                        Add Listing
                    </a>

                    <a href="/dashboard"
                       class="btn btn-primary">
                        <i class="fa-solid fa-chart-line"></i>
                        Dashboard
                    </a>

                </div>

                <% } %>

            </div>

        </div>

    </div>

    <!-- Statistics -->

    <div class="row text-center mt-4">

        <div class="col-md-4">

            <div class="card shadow-sm border-0 rounded-4 p-4 profile-stat">

                <h2><%= stats.totalListings %></h2>

                <p>
                    <i class="fa-solid fa-house"></i>
                    Listings
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm border-0 rounded-4 p-4 profile-stat">

                <h2><%= stats.wishlistCount %></h2>

                <p>
                    <i class="fa-solid fa-heart"></i>
                    Wishlist
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm border-0 rounded-4 p-4 profile-stat">

                <h2><%= stats.bookingCount %></h2>

                <p>
                    <i class="fa-solid fa-suitcase"></i>
                    Trips
                </p>

            </div>

        </div>

    </div>

    <!-- About -->

    <div class="card shadow-sm border-0 rounded-4 mt-4 p-4">

        <h3>

            <i class="fa-solid fa-circle-info"></i>

            About Me

        </h3>

        <p class="mt-3">

            <%= user.bio || "No bio added yet." %>

        </p>

    </div>

    <!-- Listings -->

    <div class="mt-5">

        <h2 class="mb-4">

            <i class="fa-solid fa-house"></i>

            My Listings

        </h2>

        <% if(listings.length === 0){ %>

            <div class="alert alert-info">

                You haven't created any listings yet.

            </div>

        <% } else { %>

        <div class="row">

            <% listings.forEach(listing => { %>

            <div class="col-lg-4 col-md-6 mb-4">

                <a
                    href="/listings/<%= listing._id %>"
                    class="text-decoration-none text-dark">

                    <div class="card h-100 shadow-sm border-0 rounded-4 profile-listing">

                        <img
                            src="<%= listing.image.url %>"
                            class="card-img-top"
                            style="height:220px; object-fit:cover; border-radius:16px 16px 0 0;"
                        >

                        <div class="card-body">

                            <h5 class="fw-bold">

                                <%= listing.title %>

                            </h5>

                            <p class="text-muted">

                                <i class="fa-solid fa-location-dot"></i>

                                <%= listing.location %>

                            </p>

                            <h5 class="text-success">

                                ₹ <%= listing.price.toLocaleString("en-IN") %>

                            </h5>

                        </div>

                    </div>

                </a>

            </div>

            <% }) %>

        </div>

        <% } %>

    </div>

</div>