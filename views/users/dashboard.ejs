<% layout("layouts/boilerplate") %>

<div class="container mt-5">

    <h2 class="mb-4">Host Dashboard</h2>

    <!-- ================= Dashboard Stats ================= -->

    <div class="row g-4">

        <div class="col-md-6 col-lg-3">
            <div class="card text-center shadow-sm border-0 p-3 h-100">
                <h2 class="fw-bold">
                    <%= totalListings %>
                </h2>
                <p class="text-muted mb-0">
                    Total Listings
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card text-center shadow-sm border-0 p-3 h-100">
                <h2 class="fw-bold">
                    <%= totalBookings %>
                </h2>
                <p class="text-muted mb-0">
                    Total Bookings
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-2">
            <div class="card text-center shadow-sm border-0 p-3 h-100">
                <h2 class="fw-bold">
                    <%= totalReviews %>
                </h2>
                <p class="text-muted mb-0">
                    Total Reviews
                </p>
            </div>
        </div>

        <div class="col-md-6 col-lg-2">
            <div class="card text-center shadow-sm border-0 p-3 h-100">
                <h2 class="fw-bold">
                    ₹<%= totalRefunded %>
                </h2>
                <p class="text-muted mb-0">
                    Total Refunded
                </p>
            </div>
        </div>

        <div class="col-md-12 col-lg-2">
            <div class="card text-center shadow-sm border-0 p-3 h-100">
                <h2 class="fw-bold text-success">
                    ₹<%= netRevenue %>
                </h2>
                <p class="text-muted mb-0">
                    Net Revenue
                </p>
            </div>
        </div>

    </div>

    <!-- ================= Quick Actions ================= -->

    <hr class="my-5">

    <h3 class="mb-4">Quick Actions</h3>

    <div class="d-flex flex-wrap gap-3 mb-5">

        <a href="/listings/new" class="btn btn-danger">
            <i class="fa-solid fa-plus"></i>
            Add Listing
        </a>

        <a href="/listings" class="btn btn-outline-dark">
            <i class="fa-solid fa-house"></i>
            View Listings
        </a>

        <a href="/trips" class="btn btn-outline-primary">
            <i class="fa-solid fa-suitcase"></i>
            My Trips
        </a>

        <a href="/wishlist" class="btn btn-outline-danger">
            <i class="fa-solid fa-heart"></i>
            Wishlist
        </a>

    </div>

    <!-- ================= My Listings ================= -->

    <hr class="my-5">

    <h3 class="mb-4">My Listings</h3>

    <% if (listings.length === 0) { %>

        <div class="alert alert-info">
            You have not created any listings yet.
        </div>

    <% } else { %>

        <div class="row">

            <% listings.forEach(listing => { %>

                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card shadow-sm border-0 h-100">

                        <img
                            src="<%= listing.image && listing.image.url ? listing.image.url : '/images/default-listing.jpg' %>"
                            class="card-img-top"
                            style="height:220px; object-fit:cover;"
                            alt="<%= listing.title %>"
                        >

                        <div class="card-body">

                            <h5 class="fw-bold">
                                <%= listing.title %>
                            </h5>

                            <p class="text-muted">
                                <i class="fa-solid fa-location-dot me-1"></i>
                                <%= listing.location %>
                            </p>

                            <a
                                href="/listings/<%= listing._id %>"
                                class="btn btn-dark"
                            >
                                View Property
                            </a>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

    <!-- ================= Recent Bookings ================= -->

    <hr class="my-5">

    <h3 class="mb-4">Recent Bookings</h3>

    <% if (bookings.length === 0) { %>

        <div class="alert alert-info">
            No bookings yet.
        </div>

    <% } else { %>

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">

                    <tr>
                        <th>Guest</th>
                        <th>Listing</th>
                        <th>Check-In</th>
                        <th>Check-Out</th>
                        <th>Booking</th>
                        <th>Payment</th>
                        <th>Refund</th>
                        <th>Total</th>
                    </tr>

                </thead>

                <tbody>

                    <% bookings.slice(0, 5).forEach(booking => { %>

                        <tr>

                            <!-- Guest -->

                            <td>
                                <% if (booking.user) { %>
                                    <%= booking.user.username %>
                                <% } else { %>
                                    <span class="text-muted">
                                        Guest unavailable
                                    </span>
                                <% } %>
                            </td>

                            <!-- Listing -->

                            <td>
                                <% if (booking.listing) { %>

                                    <a
                                        href="/listings/<%= booking.listing._id %>"
                                        class="text-decoration-none fw-semibold"
                                    >
                                        <%= booking.listing.title %>
                                    </a>

                                <% } else { %>

                                    <span class="text-muted">
                                        Property unavailable
                                    </span>

                                <% } %>
                            </td>

                            <!-- Check In -->

                            <td>
                                <%= booking.checkIn.toLocaleDateString("en-IN") %>
                            </td>

                            <!-- Check Out -->

                            <td>
                                <%= booking.checkOut.toLocaleDateString("en-IN") %>
                            </td>

                            <!-- Booking Status -->

                            <td>

                                <% if (booking.status === "Confirmed") { %>

                                    <span class="badge bg-success">
                                        <i class="fa-solid fa-circle-check me-1"></i>
                                        Confirmed
                                    </span>

                                <% } else if (booking.status === "Cancelled") { %>

                                    <span class="badge bg-danger">
                                        <i class="fa-solid fa-circle-xmark me-1"></i>
                                        Cancelled
                                    </span>

                                <% } else { %>

                                    <span class="badge bg-secondary">
                                        <%= booking.status || "Unknown" %>
                                    </span>

                                <% } %>

                            </td>

                            <!-- Payment Status -->

                            <td>

                                <% if (booking.paymentStatus === "Paid") { %>

                                    <span class="badge bg-success">
                                        Paid
                                    </span>

                                <% } else if (booking.paymentStatus === "Refunded") { %>

                                    <span class="badge bg-info text-dark">
                                        Refunded
                                    </span>

                                <% } else if (booking.paymentStatus === "Failed") { %>

                                    <span class="badge bg-danger">
                                        Failed
                                    </span>

                                <% } else { %>

                                    <span class="badge bg-secondary">
                                        <%= booking.paymentStatus || "Pending" %>
                                    </span>

                                <% } %>

                            </td>

                            <!-- Refund Status -->

                            <td>

                                <% if (booking.refundStatus === "Processed") { %>

                                    <span class="badge bg-success">
                                        ₹<%= booking.refundedAmount || 0 %>
                                    </span>

                                <% } else if (booking.refundStatus === "Pending") { %>

                                    <span class="badge bg-warning text-dark">
                                        <i class="fa-solid fa-clock me-1"></i>
                                        Processing
                                    </span>

                                <% } else if (booking.refundStatus === "Failed") { %>

                                    <span class="badge bg-danger">
                                        <i class="fa-solid fa-circle-xmark me-1"></i>
                                        Failed
                                    </span>

                                <% } else { %>

                                    <span class="text-muted">
                                        —
                                    </span>

                                <% } %>

                            </td>

                            <!-- Total -->

                            <td>
                                <strong>
                                    ₹<%= booking.totalPrice %>
                                </strong>
                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    <% } %>

    <!-- ================= Recent Reviews ================= -->

    <hr class="my-5">

    <h3 class="mb-4">Recent Reviews</h3>

    <% if (recentReviews.length === 0) { %>

        <div class="alert alert-info">
            No reviews yet.
        </div>

    <% } else { %>

        <div class="row">

            <% recentReviews.forEach(review => { %>

                <div class="col-md-6 mb-4">

                    <div class="card shadow-sm border-0 h-100">

                        <div class="card-body">

                            <h5 class="fw-bold">

                                <i class="fa-solid fa-user me-2"></i>

                                <% if (review.author) { %>
                                    <%= review.author.username %>
                                <% } else { %>
                                    Guest
                                <% } %>

                            </h5>

                            <p class="text-warning mb-2">

                                <% for (let i = 0; i < review.rating; i++) { %>

                                    <i class="fa-solid fa-star"></i>

                                <% } %>

                            </p>

                            <p>
                                <%= review.comment %>
                            </p>

                            <small class="text-muted">

                                <%= review.createdAt.toDateString() %>

                            </small>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>