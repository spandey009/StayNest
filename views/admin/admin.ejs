<% layout("layouts/boilerplate") %>
<style>
.admin-page{min-height:100vh;background:#f7f8fa;padding:30px 20px 60px}
.admin-container{width:100%;max-width:1280px;margin:0 auto}
.admin-header{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:25px}
.admin-badge{display:block;margin-bottom:5px;color:#ff5a5f;font-size:11px;font-weight:800;letter-spacing:1.5px}
.admin-title h1{margin:0 0 5px;color:#18213d;font-size:34px;font-weight:800}
.admin-title p{margin:0;color:#737986;font-size:14px}
.admin-status{display:flex;align-items:center;gap:7px;padding:9px 13px;background:#fff;border:1px solid #e6e8eb;border-radius:10px;color:#398f55;font-size:13px;font-weight:700}
.admin-status-dot{width:8px;height:8px;border-radius:50%;background:#398f55}
.admin-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:15px;margin-bottom:22px}
.admin-stat{padding:18px;background:#fff;border:1px solid #eceef1;border-radius:16px;box-shadow:0 7px 22px rgba(0,0,0,.035)}
.admin-stat-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:13px}
.admin-stat-label{color:#737986;font-size:11px;font-weight:700}
.admin-stat-icon{width:38px;height:38px;display:flex;align-items:center;justify-content:center;border-radius:11px;background:#fff0f1;color:#ff5a5f}
.admin-stat-value{color:#18213d;font-size:27px;font-weight:800}
.admin-stat-extra{margin-top:4px;color:#737986;font-size:10px}
.admin-section{margin-bottom:20px;background:#fff;border:1px solid #eceef1;border-radius:17px;overflow:hidden;box-shadow:0 7px 22px rgba(0,0,0,.035)}
.admin-section-header{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:17px 20px;border-bottom:1px solid #eee}
.admin-section-header h2{margin:0;color:#18213d;font-size:17px;font-weight:800}
.admin-section-header small{color:#737986;font-size:11px}
.admin-tools{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.admin-search{display:flex;align-items:center;gap:7px}
.admin-search input,.admin-select{height:36px;padding:0 11px;border:1px solid #dddfe3;border-radius:9px;background:#fff;color:#18213d;font-size:12px;outline:none}
.admin-search input{width:220px}
.admin-search input:focus,.admin-select:focus{border-color:#ff5a5f}
.admin-btn{display:inline-flex;align-items:center;justify-content:center;gap:5px;min-height:36px;padding:0 11px;border:1px solid transparent;border-radius:9px;background:#ff5a5f;color:#fff;text-decoration:none;cursor:pointer;font-size:11px;font-weight:700;white-space:nowrap}
.admin-btn:hover{background:#f04f55;color:#fff}
.admin-btn-light{background:#fff;color:#18213d;border-color:#dddfe3}
.admin-btn-light:hover{background:#fafafa;color:#ff5a5f;border-color:#ff5a5f}
.admin-btn-danger{background:#fff0f1;color:#e64b52;border-color:#ffd9dc}
.admin-btn-danger:hover{background:#ff5a5f;color:#fff;border-color:#ff5a5f}
.admin-btn-green{background:#eef8f1;color:#398f55;border-color:#d5eadb}
.admin-btn-green:hover{background:#398f55;color:#fff}
.admin-table-wrap{width:100%;overflow-x:auto}
.admin-table{width:100%;min-width:800px;border-collapse:collapse}
.admin-table th{padding:11px 15px;background:#fafafa;border-bottom:1px solid #eee;color:#737986;text-align:left;font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.5px}
.admin-table td{padding:12px 15px;border-bottom:1px solid #f0f0f0;color:#18213d;font-size:12px;vertical-align:middle}
.admin-table tbody tr:last-child td{border-bottom:0}
.admin-table tbody tr:hover{background:#fcfcfd}
.admin-user{display:flex;align-items:center;gap:9px}
.admin-user-img{width:34px;height:34px;border-radius:50%;object-fit:cover;background:#eee}
.admin-user-name{font-weight:800}
.admin-user-email{margin-top:2px;color:#737986;font-size:10px}
.admin-role,.admin-status-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 8px;border-radius:20px;font-size:9px;font-weight:800}
.admin-role{background:#f1f3f5;color:#687080}
.admin-role-admin{background:#fff0f1;color:#ff5a5f}
.admin-status-badge{background:#eef8f1;color:#398f55}
.admin-status-cancelled{background:#fff0f1;color:#e64b52}
.admin-status-waiting{background:#fff7e8;color:#b67813}
.admin-actions{display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.admin-muted{color:#737986}
.admin-price{font-weight:800}
.admin-review{max-width:330px;line-height:1.45}
.admin-stars{color:#f5ae00;letter-spacing:1px}
.admin-support-message{max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#737986}
.admin-empty{padding:35px 20px;text-align:center;color:#737986;font-size:12px}
.admin-footer{text-align:center;margin-top:25px;color:#9a9da5;font-size:11px}
.admin-modal{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(15,20,35,.55)}
.admin-modal.show{display:flex}
.admin-modal-box{width:100%;max-width:720px;max-height:85vh;overflow:hidden;background:#fff;border-radius:18px;box-shadow:0 20px 70px rgba(0,0,0,.2)}
.admin-modal-header{display:flex;align-items:center;justify-content:space-between;padding:17px 20px;border-bottom:1px solid #eee}
.admin-modal-header h3{margin:0;color:#18213d;font-size:17px}
.admin-modal-close{width:32px;height:32px;border:0;border-radius:8px;background:#f3f4f6;color:#18213d;cursor:pointer}
.admin-modal-body{max-height:calc(85vh - 70px);overflow-y:auto;padding:18px}
.admin-message{display:flex;margin-bottom:10px}
.admin-message-user{justify-content:flex-start}
.admin-message-ai,.admin-message-agent{justify-content:flex-end}
.admin-message-bubble{max-width:75%;padding:9px 12px;border-radius:13px;background:#f0f2f5;color:#18213d;font-size:12px;line-height:1.45;white-space:pre-wrap;overflow-wrap:anywhere}
.admin-message-ai .admin-message-bubble{background:#fff0f1}
.admin-message-agent .admin-message-bubble{background:#eef8f1}
.admin-message-meta{margin-bottom:3px;color:#737986;font-size:9px}
.admin-loader{text-align:center;padding:35px;color:#737986;font-size:12px}
@media(max-width:1100px){.admin-stats{grid-template-columns:repeat(3,1fr)}}
@media(max-width:800px){
.admin-page{padding:24px 12px 45px}
.admin-header{align-items:flex-start;flex-direction:column}
.admin-title h1{font-size:29px}
.admin-stats{grid-template-columns:repeat(2,1fr)}
.admin-section-header{align-items:flex-start;flex-direction:column}
.admin-tools{width:100%}
.admin-search{width:100%}
.admin-search input{flex:1;width:auto}
}
@media(max-width:500px){
.admin-stats{grid-template-columns:1fr}
.admin-search{flex-wrap:wrap}
.admin-search input{flex-basis:100%;width:100%}
.admin-search .admin-btn{flex:1}
.admin-tools{flex-direction:column;align-items:stretch}
.admin-select,.admin-tools .admin-btn{width:100%}
.admin-modal{padding:10px}
.admin-message-bubble{max-width:88%}
}
</style>

<div class="admin-page">
<div class="admin-container">
<div class="admin-header">
<div class="admin-title">
<span class="admin-badge">STAYNEST ADMIN</span>
<h1>Admin Dashboard</h1>
<p>Manage your platform from one place.</p>
</div>
<div class="admin-status">
<span class="admin-status-dot"></span>
Admin Online
</div>
</div>

<div class="admin-stats">
<div class="admin-stat">
<div class="admin-stat-top">
<span class="admin-stat-label">TOTAL USERS</span>
<div class="admin-stat-icon"><i class="fa-solid fa-users"></i></div>
</div>
<div class="admin-stat-value"><%= totalUsers %></div>
</div>
<div class="admin-stat">
<div class="admin-stat-top">
<span class="admin-stat-label">LISTINGS</span>
<div class="admin-stat-icon"><i class="fa-solid fa-house"></i></div>
</div>
<div class="admin-stat-value"><%= totalListings %></div>
</div>
<div class="admin-stat">
<div class="admin-stat-top">
<span class="admin-stat-label">BOOKINGS</span>
<div class="admin-stat-icon"><i class="fa-solid fa-calendar-check"></i></div>
</div>
<div class="admin-stat-value"><%= totalBookings %></div>
</div>
<div class="admin-stat">
<div class="admin-stat-top">
<span class="admin-stat-label">REVIEWS</span>
<div class="admin-stat-icon"><i class="fa-solid fa-star"></i></div>
</div>
<div class="admin-stat-value"><%= totalReviews %></div>
</div>
<div class="admin-stat">
<div class="admin-stat-top">
<span class="admin-stat-label">SUPPORT</span>
<div class="admin-stat-icon"><i class="fa-solid fa-headset"></i></div>
</div>
<div class="admin-stat-value"><%= totalConversations %></div>
<div class="admin-stat-extra"><%= waitingSupport %> waiting</div>
</div>
</div>

<div class="admin-section">
<div class="admin-section-header">
<div>
<h2>Revenue Overview</h2>
<small>Based on your current booking payment records</small>
</div>
</div>
<div class="admin-stats" style="margin:0;padding:15px">
<div class="admin-stat">
<div class="admin-stat-label">PAID REVENUE</div>
<div class="admin-stat-value">₹<%= Number(paidRevenue || 0).toLocaleString("en-IN") %></div>
</div>
<div class="admin-stat">
<div class="admin-stat-label">REFUNDED</div>
<div class="admin-stat-value">₹<%= Number(refundedAmount || 0).toLocaleString("en-IN") %></div>
</div>
<div class="admin-stat">
<div class="admin-stat-label">NET REVENUE</div>
<div class="admin-stat-value">₹<%= Number(netRevenue || 0).toLocaleString("en-IN") %></div>
</div>
</div>
</div>

<div class="admin-section">
<div class="admin-section-header">
<div>
<h2>User Management</h2>
<small><%= users.length %> users shown</small>
</div>
<form action="/admin" method="GET" class="admin-search">
<input type="search" name="userSearch" value="<%= userSearch || '' %>" placeholder="Search username or email..." autocomplete="off">
<button class="admin-btn" type="submit"><i class="fa-solid fa-search"></i> Search</button>
<% if (userSearch) { %>
<a href="/admin" class="admin-btn admin-btn-light">Clear</a>
<% } %>
</form>
</div>
<% if (users.length) { %>
<div class="admin-table-wrap">
<table class="admin-table">
<thead>
<tr>
<th>User</th>
<th>Role</th>
<th>Location</th>
<th>Joined</th>
<th>Actions</th>
</tr>
</thead>
<tbody>
<% users.forEach(user => { %>
<tr>
<td>
<div class="admin-user">
<img class="admin-user-img" src="<%= user.profileImage && user.profileImage.url ? user.profileImage.url : 'https://res.cloudinary.com/demo/image/upload/v1312461204/sample.jpg' %>" alt="">
<div>
<div class="admin-user-name"><%= user.username %></div>
<div class="admin-user-email"><%= user.email %></div>
</div>
</div>
</td>
<td>
<span class="admin-role <%= user.isAdmin ? 'admin-role-admin' : '' %>">
<i class="fa-solid <%= user.isAdmin ? 'fa-shield-halved' : 'fa-user' %>"></i>
<%= user.isAdmin ? "Admin" : "User" %>
</span>
</td>
<td><span class="admin-muted"><%= user.location || "—" %></span></td>
<td><span class="admin-muted"><%= user.joinedAt ? new Date(user.joinedAt).toLocaleDateString("en-IN") : "—" %></span></td>
<td>
<div class="admin-actions">
<a href="/users/<%= user._id %>" class="admin-btn admin-btn-light"><i class="fa-solid fa-eye"></i></a>
<% if (String(user._id) !== String(currentUserId)) { %>
<form action="/admin/users/<%= user._id %>/toggle-admin" method="POST">
<button class="admin-btn <%= user.isAdmin ? 'admin-btn-danger' : 'admin-btn-green' %>" type="submit">
<i class="fa-solid fa-shield"></i>
<%= user.isAdmin ? "Remove Admin" : "Make Admin" %>
</button>
</form>
<% } %>
</div>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
<% } else { %>
<div class="admin-empty">No users matched your search.</div>
<% } %>
</div>

<div class="admin-section">
<div class="admin-section-header">
<div>
<h2>Listings Management</h2>
<small><%= listings.length %> listings shown</small>
</div>
<form action="/admin" method="GET" class="admin-search">
<input type="search" name="listingSearch" value="<%= listingSearch || '' %>" placeholder="Search title, location, category...">
<button class="admin-btn" type="submit"><i class="fa-solid fa-search"></i> Search</button>
<% if (listingSearch) { %>
<a href="/admin" class="admin-btn admin-btn-light">Clear</a>
<% } %>
</form>
</div>
<% if (listings.length) { %>
<div class="admin-table-wrap">
<table class="admin-table">
<thead>
<tr>
<th>Listing</th>
<th>Owner</th>
<th>Location</th>
<th>Category</th>
<th>Price</th>
<th>Reviews</th>
<th>Actions</th>
</tr>
</thead>
<tbody>
<% listings.forEach(listing => { %>
<tr>
<td><strong><%= listing.title %></strong></td>
<td><%= listing.owner ? listing.owner.username : "Unknown" %></td>
<td><%= listing.location || "—" %>, <%= listing.country || "" %></td>
<td><%= listing.category || "—" %></td>
<td class="admin-price">₹<%= Number(listing.price || 0).toLocaleString("en-IN") %></td>
<td><%= listing.reviews ? listing.reviews.length : 0 %></td>
<td>
<div class="admin-actions">
<a href="/listings/<%= listing._id %>" class="admin-btn admin-btn-light">View</a>
<% if (!listing.bookings || listing.bookings.length === 0) { %>
<form action="/admin/listings/<%= listing._id %>/delete" method="POST" onsubmit="return confirm('Delete this listing? This action cannot be undone.')">
<button class="admin-btn admin-btn-danger" type="submit">Delete</button>
</form>
<% } else { %>
<span class="admin-muted">Has bookings</span>
<% } %>
</div>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
<% } else { %>
<div class="admin-empty">No listings found.</div>
<% } %>
</div>

<div class="admin-section">
<div class="admin-section-header">
<div>
<h2>Booking Management</h2>
<small><%= bookings.length %> bookings shown</small>
</div>
<form action="/admin" method="GET" class="admin-tools">
<select name="bookingStatus" class="admin-select" onchange="this.form.submit()">
<option value="">All Statuses</option>
<option value="Confirmed" <%= bookingStatus === "Confirmed" ? "selected" : "" %>>Confirmed</option>
<option value="Cancelled" <%= bookingStatus === "Cancelled" ? "selected" : "" %>>Cancelled</option>
</select>
</form>
</div>
<% if (bookings.length) { %>
<div class="admin-table-wrap">
<table class="admin-table">
<thead>
<tr>
<th>Listing</th>
<th>User</th>
<th>Dates</th>
<th>Guests</th>
<th>Total</th>
<th>Payment</th>
<th>Status</th>
<th>Details</th>
</tr>
</thead>
<tbody>
<% bookings.forEach(booking => { %>
<tr>
<td>
<strong><%= booking.listing ? booking.listing.title : "Listing unavailable" %></strong>
<div class="admin-user-email"><%= booking.listing ? booking.listing.location || "" : "" %></div>
</td>
<td>
<%= booking.user ? booking.user.username : "Unknown" %>
<div class="admin-user-email"><%= booking.user ? booking.user.email : "" %></div>
</td>
<td>
<%= booking.checkIn ? new Date(booking.checkIn).toLocaleDateString("en-IN") : "—" %>
→
<%= booking.checkOut ? new Date(booking.checkOut).toLocaleDateString("en-IN") : "—" %>
</td>
<td><%= booking.guests %></td>
<td class="admin-price">₹<%= Number(booking.totalPrice || 0).toLocaleString("en-IN") %></td>
<td>
<span class="admin-status-badge <%= booking.paymentStatus === "Refunded" ? "admin-status-cancelled" : "" %>">
<%= booking.paymentStatus || "Pending" %>
</span>
<% if (booking.refundedAmount) { %>
<div class="admin-user-email">Refund: ₹<%= Number(booking.refundedAmount).toLocaleString("en-IN") %></div>
<% } %>
</td>
<td>
<span class="admin-status-badge <%= booking.status === "Cancelled" ? "admin-status-cancelled" : "" %>">
<%= booking.status %>
</span>
</td>
<td>
<button type="button" class="admin-btn admin-btn-light" onclick='showBookingDetails(<%- JSON.stringify({
listing: booking.listing ? booking.listing.title : "Unavailable",
user: booking.user ? booking.user.username : "Unknown",
email: booking.user ? booking.user.email : "",
checkIn: booking.checkIn ? new Date(booking.checkIn).toLocaleDateString("en-IN") : "—",
checkOut: booking.checkOut ? new Date(booking.checkOut).toLocaleDateString("en-IN") : "—",
guests: booking.guests,
nights: booking.nights,
totalPrice: booking.totalPrice,
paymentStatus: booking.paymentStatus,
paymentId: booking.paymentId || "",
orderId: booking.orderId || "",
refundStatus: booking.refundStatus || "",
refundedAmount: booking.refundedAmount || 0,
refundedAt: booking.refundedAt ? new Date(booking.refundedAt).toLocaleDateString("en-IN") : "",
status: booking.status
}) %>)'>View</button>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
<% } else { %>
<div class="admin-empty">No bookings found.</div>
<% } %>
</div>

<div class="admin-section">
<div class="admin-section-header">
<div>
<h2>Review Management</h2>
<small>Latest <%= reviews.length %> reviews</small>
</div>
</div>
<% if (reviews.length) { %>
<div class="admin-table-wrap">
<table class="admin-table">
<thead>
<tr>
<th>Author</th>
<th>Rating</th>
<th>Review</th>
<th>Date</th>
<th>Action</th>
</tr>
</thead>
<tbody>
<% reviews.forEach(review => { %>
<tr>
<td>
<strong><%= review.author ? review.author.username : "Unknown" %></strong>
<div class="admin-user-email"><%= review.author ? review.author.email : "" %></div>
</td>
<td>
<span class="admin-stars">
<%= "★".repeat(Number(review.rating) || 0) %>
</span>
</td>
<td><div class="admin-review"><%= review.comment || "No comment" %></div></td>
<td><%= review.createdAt ? new Date(review.createdAt).toLocaleDateString("en-IN") : "—" %></td>
<td>
<form action="/admin/reviews/<%= review._id %>/delete" method="POST" onsubmit="return confirm('Delete this review?')">
<button class="admin-btn admin-btn-danger" type="submit">Delete</button>
</form>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
<% } else { %>
<div class="admin-empty">No reviews found.</div>
<% } %>
</div>

<div class="admin-section">
<div class="admin-section-header">
<div>
<h2>24×7 Support Management</h2>
<small><%= openSupport %> open · <%= waitingSupport %> waiting · <%= resolvedSupport %> resolved</small>
</div>
<form action="/admin" method="GET" class="admin-tools">
<select name="supportStatus" class="admin-select" onchange="this.form.submit()">
<option value="">All Conversations</option>
<option value="open" <%= supportStatus === "open" ? "selected" : "" %>>Open</option>
<option value="waiting" <%= supportStatus === "waiting" ? "selected" : "" %>>Waiting</option>
<option value="resolved" <%= supportStatus === "resolved" ? "selected" : "" %>>Resolved</option>
</select>
</form>
</div>
<% if (conversations.length) { %>
<div class="admin-table-wrap">
<table class="admin-table">
<thead>
<tr>
<th>User</th>
<th>Subject</th>
<th>Last Message</th>
<th>Status</th>
<th>AI</th>
<th>Actions</th>
</tr>
</thead>
<tbody>
<% conversations.forEach(conversation => { %>
<tr>
<td>
<div class="admin-user">
<img class="admin-user-img" src="<%= conversation.user && conversation.user.profileImage && conversation.user.profileImage.url ? conversation.user.profileImage.url : 'https://res.cloudinary.com/demo/image/upload/v1312461204/sample.jpg' %>" alt="">
<div>
<div class="admin-user-name"><%= conversation.user ? conversation.user.username : "Unknown" %></div>
<div class="admin-user-email"><%= conversation.user ? conversation.user.email : "" %></div>
</div>
</div>
</td>
<td><strong><%= conversation.subject || "StayNest Support" %></strong></td>
<td><div class="admin-support-message"><%= conversation.lastMessage || "No messages" %></div></td>
<td>
<span class="admin-status-badge <%= conversation.status === "waiting" ? "admin-status-waiting" : conversation.status === "resolved" ? "admin-status-cancelled" : "" %>">
<%= conversation.status %>
</span>
</td>
<td>
<span class="admin-role">
<%= conversation.aiEnabled ? "Enabled" : "Off" %>
</span>
</td>
<td>
<div class="admin-actions">
<button type="button" class="admin-btn admin-btn-light" onclick="openConversation('<%= conversation._id %>')">View Chat</button>
<% if (conversation.status !== "resolved") { %>
<form action="/admin/support/<%= conversation._id %>/resolve" method="POST">
<button class="admin-btn admin-btn-green" type="submit">Resolve</button>
</form>
<% } %>
<form action="/admin/support/<%= conversation._id %>/delete" method="POST" onsubmit="return confirm('Delete this conversation and all its messages?')">
<button class="admin-btn admin-btn-danger" type="submit">Delete</button>
</form>
</div>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
<% } else { %>
<div class="admin-empty">No support conversations found.</div>
<% } %>
</div>

<div class="admin-footer">
StayNest Admin Panel · Platform Management
</div>
</div>
</div>

<div class="admin-modal" id="conversationModal">
<div class="admin-modal-box">
<div class="admin-modal-header">
<h3 id="conversationTitle">Support Conversation</h3>
<button type="button" class="admin-modal-close" onclick="closeConversation()">×</button>
</div>
<div class="admin-modal-body" id="conversationBody">
<div class="admin-loader">Loading conversation...</div>
</div>
</div>
</div>

<div class="admin-modal" id="bookingModal">
<div class="admin-modal-box">
<div class="admin-modal-header">
<h3>Booking Details</h3>
<button type="button" class="admin-modal-close" onclick="closeBooking()">×</button>
</div>
<div class="admin-modal-body" id="bookingBody"></div>
</div>
</div>

<script>
function openConversation(id){
    const modal=document.getElementById("conversationModal");
    const body=document.getElementById("conversationBody");
    const title=document.getElementById("conversationTitle");
    modal.classList.add("show");
    body.innerHTML='<div class="admin-loader">Loading conversation...</div>';
    fetch("/admin/support/"+id+"/messages")
        .then(response=>response.json())
        .then(data=>{
            if(!data.success) throw new Error(data.message||"Unable to load conversation.");
            const conversation=data.conversation;
            title.textContent=conversation.subject||"StayNest Support";
            if(!data.messages.length){
                body.innerHTML='<div class="admin-empty">No messages in this conversation.</div>';
                return;
            }
            body.innerHTML="";
            data.messages.forEach(message=>{
                const row=document.createElement("div");
                row.className="admin-message "+(
                    message.senderType==="user"
                        ?"admin-message-user"
                        :message.senderType==="agent"
                            ?"admin-message-agent"
                            :"admin-message-ai"
                );
                const wrapper=document.createElement("div");
                const meta=document.createElement("div");
                meta.className="admin-message-meta";
                const sender=message.senderType==="user"
                    ?(conversation.user?.username||"User")
                    :message.senderType==="agent"
                        ?(message.sender?.username||"Support Agent")
                        :"StayNest AI";
                meta.textContent=sender+" · "+new Date(message.createdAt).toLocaleString("en-IN");
                const bubble=document.createElement("div");
                bubble.className="admin-message-bubble";
                bubble.textContent=message.message;
                wrapper.appendChild(meta);
                wrapper.appendChild(bubble);
                row.appendChild(wrapper);
                body.appendChild(row);
            });
        })
        .catch(error=>{
            console.error(error);
            body.innerHTML='<div class="admin-empty">Unable to load this conversation.</div>';
        });
}
function closeConversation(){
    document.getElementById("conversationModal").classList.remove("show");
}
function showBookingDetails(booking){
    const body=document.getElementById("bookingBody");
    body.innerHTML="";
    const details=[
        ["User",booking.user],
        ["Email",booking.email||"—"],
        ["Listing",booking.listing],
        ["Check-in",booking.checkIn],
        ["Check-out",booking.checkOut],
        ["Guests",booking.guests],
        ["Nights",booking.nights],
        ["Total Price","₹"+Number(booking.totalPrice||0).toLocaleString("en-IN")],
        ["Booking Status",booking.status],
        ["Payment Status",booking.paymentStatus||"—"],
        ["Payment ID",booking.paymentId||"—"],
        ["Order ID",booking.orderId||"—"],
        ["Refund Status",booking.refundStatus||"—"],
        ["Refunded Amount","₹"+Number(booking.refundedAmount||0).toLocaleString("en-IN")],
        ["Refunded At",booking.refundedAt||"—"]
    ];
    details.forEach(item=>{
        const row=document.createElement("div");
        row.style.cssText="display:flex;justify-content:space-between;gap:20px;padding:10px 0;border-bottom:1px solid #eee;font-size:12px";
        row.innerHTML="<strong>"+escapeHtml(item[0])+"</strong><span>"+escapeHtml(String(item[1]))+"</span>";
        body.appendChild(row);
    });
    document.getElementById("bookingModal").classList.add("show");
}
function closeBooking(){
    document.getElementById("bookingModal").classList.remove("show");
}
function escapeHtml(value){
    return value.replace(/[&<>"']/g,char=>({
        "&":"&amp;",
        "<":"&lt;",
        ">":"&gt;",
        '"':"&quot;",
        "'":"&#039;"
    }[char]));
}
document.querySelectorAll(".admin-modal").forEach(modal=>{
    modal.addEventListener("click",event=>{
        if(event.target===modal){
            modal.classList.remove("show");
        }
    });
});
document.addEventListener("keydown",event=>{
    if(event.key==="Escape"){
        closeConversation();
        closeBooking();
    }
});
</script>