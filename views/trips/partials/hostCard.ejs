<!-- ================= Host Information ================= -->

<div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-body">

        <h4 class="fw-bold mb-4">
            👤 Your Host
        </h4>

        <div class="d-flex align-items-center">

            <!-- Host Image -->

            <% if (
                booking.listing.owner.profileImage &&
                booking.listing.owner.profileImage.url
            ) { %>

                <img
                    src="<%= booking.listing.owner.profileImage.url %>"
                    alt="<%= booking.listing.owner.username %>"
                    class="rounded-circle me-3"
                    style="
                        width:70px;
                        height:70px;
                        object-fit:cover;
                    ">

            <% } else { %>

                <div
                    class="rounded-circle bg-light d-flex
                           align-items-center justify-content-center me-3"
                    style="
                        width:70px;
                        height:70px;
                    ">

                    <i class="fa-solid fa-user fa-2x text-secondary"></i>

                </div>

            <% } %>

            <!-- Host Details -->

            <div>

                <h5 class="fw-bold mb-1">

                    <%= booking.listing.owner.username %>

                </h5>

                <p class="text-muted mb-2">

                    <i class="fa-solid fa-envelope me-1"></i>

                    <%= booking.listing.owner.email %>

                </p>

                <a
                    href="/users/<%= booking.listing.owner._id %>"
                    class="btn btn-outline-dark btn-sm rounded-pill">

                    <i class="fa-solid fa-user me-1"></i>

                    View Profile

                </a>

            </div>

        </div>

    </div>

</div>