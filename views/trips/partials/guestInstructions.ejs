<!-- ================= Guest Instructions ================= -->

<div class="card border-0 shadow-sm rounded-4 mt-4">

    <div class="card-body">

        <h4 class="fw-bold mb-4">
            🧳 Guest Information
        </h4>

        <div class="row g-4">

            <!-- Check In -->

            <div class="col-md-6">

                <div class="d-flex align-items-start">

                    <i class="fa-solid fa-clock text-primary fs-4 me-3"></i>

                    <div>

                        <h6 class="fw-bold mb-1">
                            Check-in
                        </h6>

                        <p class="text-muted mb-0">
                            Please arrive on your scheduled check-in date.
                        </p>

                    </div>

                </div>

            </div>

            <!-- Check Out -->

            <div class="col-md-6">

                <div class="d-flex align-items-start">

                    <i class="fa-solid fa-right-from-bracket text-danger fs-4 me-3"></i>

                    <div>

                        <h6 class="fw-bold mb-1">
                            Check-out
                        </h6>

                        <p class="text-muted mb-0">
                            Please check out on your scheduled check-out date.
                        </p>

                    </div>

                </div>

            </div>

            <!-- Contact Host -->

            <div class="col-md-6">

                <div class="d-flex align-items-start">

                    <i class="fa-solid fa-user-tie text-success fs-4 me-3"></i>

                    <div>

                        <h6 class="fw-bold mb-1">
                            Contact Your Host
                        </h6>

                        <p class="text-muted mb-0">
                            Contact the host if you need help with your stay.
                        </p>

                    </div>

                </div>

            </div>

            <!-- Booking Information -->

            <div class="col-md-6">

                <div class="d-flex align-items-start">

                    <i class="fa-solid fa-circle-info text-warning fs-4 me-3"></i>

                    <div>

                        <h6 class="fw-bold mb-1">
                            Keep Booking Details
                        </h6>

                        <p class="text-muted mb-0">
                            Keep your booking and payment information available during your stay.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>