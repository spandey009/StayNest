<!-- ================= Cancellation Policy ================= -->

<div class="card border-0 shadow-sm rounded-4 mt-4">

    <div class="card-body">

        <h4 class="fw-bold mb-4">
            🛡️ Cancellation Policy
        </h4>

        <% if (booking.status === "Cancelled") { %>

            <div class="alert alert-danger mb-0">

                <i class="fa-solid fa-circle-xmark me-2"></i>

                This booking has been cancelled.

            </div>

        <% } else { %>

            <div class="d-flex align-items-start mb-4">

                <i class="fa-solid fa-calendar-check text-success fs-4 me-3"></i>

                <div>

                    <h6 class="fw-bold mb-1">
                        Current Booking
                    </h6>

                    <p class="text-muted mb-0">
                        Your booking is currently confirmed.
                    </p>

                </div>

            </div>

            <div class="d-flex align-items-start mb-4">

                <i class="fa-solid fa-circle-info text-primary fs-4 me-3"></i>

                <div>

                    <h6 class="fw-bold mb-1">
                        Cancellation
                    </h6>

                    <p class="text-muted mb-0">
                        Cancellation availability depends on the booking
                        policy configured for the property.
                    </p>

                </div>

            </div>

            <div class="d-flex align-items-start">

                <i class="fa-solid fa-user-tie text-warning fs-4 me-3"></i>

                <div>

                    <h6 class="fw-bold mb-1">
                        Need Help?
                    </h6>

                    <p class="text-muted mb-0">
                        Contact your host if you have questions about
                        cancelling or modifying your stay.
                    </p>

                </div>

            </div>

        <% } %>

    </div>

</div>